# ====================================================
#  BISANI BROTHERS - LIVE SERVER .HTACCESS
# ====================================================

# 1. PREVENT DIRECTORY BROWSING
Options -Indexes

# Security headers (HTML/API responses)
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block sensitive config, dumps, and env files
<IfModule mod_authz_core.c>
    <FilesMatch "^(db\.php|db\.local\.php|\.env|\.gitignore)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "\.(sql|bak|log|env|local\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "^(db\.php|db\.local\.php|\.env|\.gitignore)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
    <FilesMatch "\.(sql|bak|log|env|local\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 2. ENABLE REWRITE ENGINE
RewriteEngine On

# Block direct web access to internal folders and CLI-only reindex
RewriteRule ^seo-reindex\.php$ - [F,L]

# Block direct web access to internal folders
RewriteRule ^(?:includes|scripts|storage|node_modules)/ - [F,L]
RewriteRule ^assets/ckeditor/samples/ - [F,L]

# RewriteBase auto-detected from .htaccess directory (works in subfolder + live root)

# ----------------------------------------------------
#  FIX: REMOVE DOUBLE SLASHES (production only)
# ----------------------------------------------------
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{THE_REQUEST} \s//([^\s]*) [NC]
RewriteRule ^ https://www.bisanibrothers.com/%1 [R=301,L]

# ----------------------------------------------------
#  FIX: SINGLE-HOP WWW + HTTPS (production only)
# ----------------------------------------------------
RewriteCond %{HTTP_HOST} !^localhost(:\d+)?$ [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1(:\d+)?$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.bisanibrothers.com/$1 [R=301,L]

# ----------------------------------------------------
#  SITEMAP, FEEDS & SEARCH DISCOVERY
# ----------------------------------------------------
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^llms\.txt$ llms.php [L]
RewriteRule ^rss\.xml$ rss.php [L]
RewriteRule ^feed\.xml$ rss.php [L]
RewriteRule ^opensearch\.xml$ opensearch.php [L]
RewriteRule ^bb-analytics\.js$ bb-analytics.php [L]
RewriteRule ^bb-beacon\.gif$ bb-beacon.php [L]
RewriteRule ^bb-blog-warm$ bb-blog-warm.php [L,QSA]

# Redirect old locale URLs to English (301)
RewriteRule ^(hi|bn|mr|ta|te|gu|kn|ml|pa|or|ur)/(.*)$ /$2 [R=301,L]
RewriteRule ^(hi|bn|mr|ta|te|gu|kn|ml|pa|or|ur)/?$ / [R=301,L]

# Job detail pages (must be before blog slug catch-all)
RewriteRule ^jobs/([^/]+)/?$ job-details.php?slug=$1 [L,QSA]

# Case studies & industry pages
RewriteRule ^case-studies/([^/]+)/?$ case-study-details.php?slug=$1 [L,QSA]
RewriteRule ^industries/([^/]+)/?$ industry.php?slug=$1 [L,QSA]

# ----------------------------------------------------
#  SEO FIX: REDIRECT OLD BLOG URLs TO NEW CLEAN URLs
#  (Changes /blog-details/slug to just /slug)
# ----------------------------------------------------
RewriteRule ^blog-details/([^/]+)/?$ $1 [R=301,L]

# ====================================================
#  GENERIC CLEAN URLs (REMOVE .PHP)
# ====================================================

# 1. If the request is for a real file/folder, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Redirect external .php requests to extensionless URL
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# 3. Internally rewrite extensionless URL to .php file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# ====================================================
#  DYNAMIC BLOG SLUG ROUTING (NEW)
#  If it's not a folder, not a file, and not a .php page, 
#  treat it as a blog slug!
# ====================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)/?$ blog-details.php?slug=$1 [L,QSA]

# ====================================================
#  STATIC ASSET CACHING (speed)
# ====================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|png|jpe?g|svg|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ====================================================
#  ERROR HANDLING
# ====================================================
ErrorDocument 404 404.php